      <column caption='DURN' datatype='real' name='[Calculation_1572587698782215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF LOWER([booking_status]) = &quot;checked out&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([check_in_date])' />
