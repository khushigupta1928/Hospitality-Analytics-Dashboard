      </column>
      <column caption='Cancellation %' datatype='real' name='[Calculation_1210572344492039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [booking_status]=&apos;Cancelled&apos; THEN 1 ELSE 0 END)/COUNT([booking_id])' />
      </column>
      <column caption='Total Checked Out' datatype='real' name='[Calculation_1210572347228168]' role='measure' type='quantitative'>
